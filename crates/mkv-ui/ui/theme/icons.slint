// Icon registry. Icons are single-colour outline SVGs (24×24 grid, chunky 2.5
// stroke) tinted at runtime with `colorize`, so every icon follows the
// theme. Reference icons by name (`Icons.audio`), never by file path.

export global Icons {
    out property <image> alert: @image-url("../icons/alert.svg");
    out property <image> arrow-up: @image-url("../icons/arrow-up.svg");
    out property <image> audio: @image-url("../icons/audio.svg");
    out property <image> check: @image-url("../icons/check.svg");
    out property <image> chevron-down: @image-url("../icons/chevron-down.svg");
    out property <image> chevron-up: @image-url("../icons/chevron-up.svg");
    out property <image> close: @image-url("../icons/close.svg");
    out property <image> copy-all: @image-url("../icons/copy-all.svg");
    out property <image> file: @image-url("../icons/file.svg");
    out property <image> folder: @image-url("../icons/folder.svg");
    out property <image> info: @image-url("../icons/info.svg");
    out property <image> layers: @image-url("../icons/layers.svg");
    out property <image> moon: @image-url("../icons/moon.svg");
    out property <image> movie: @image-url("../icons/movie.svg");
    out property <image> plus: @image-url("../icons/plus.svg");
    out property <image> reset: @image-url("../icons/reset.svg");
    out property <image> save: @image-url("../icons/save.svg");
    out property <image> search: @image-url("../icons/search.svg");
    out property <image> settings: @image-url("../icons/settings.svg");
    out property <image> subtitle: @image-url("../icons/subtitle.svg");
    out property <image> sun: @image-url("../icons/sun.svg");
    out property <image> tag: @image-url("../icons/tag.svg");
    out property <image> trash: @image-url("../icons/trash.svg");
    out property <image> video: @image-url("../icons/video.svg");
    out property <image> wand: @image-url("../icons/wand.svg");
}

// Tileable decoration images (single colour, tinted with `colorize`).
export global Patterns {
    // Dot grid for the canvas, one dot per `Theme.pattern-spacing` cell.
    out property <image> dots: @image-url("../patterns/dots.svg");
    // Diagonal candy stripes for progress bars.
    out property <image> stripes: @image-url("../patterns/stripes.svg");
}
