// Primitive colour palette — the only place raw colour values live.
//
// Nothing outside `ui/theme/` may reference `Swatches`: components and
// views consume the semantic tokens in `Theme`, which map these primitives
// per colour scheme. Changing a hue here restyles the whole app.
//
// Playful Geometric: warm paper, slate ink, and a punchy violet / pink /
// yellow / mint "confetti" set. Night swatches are the dark-scheme
// counterparts: plum-slate paper, cream ink, lighter pastels.

export global Swatches {
    // Paper & ink (light scheme).
    out property <color> paper: #FFFDF5;
    out property <color> white: #FFFFFF;
    out property <color> slate-50: #F8FAFC;
    out property <color> slate-100: #F1F5F9;
    out property <color> slate-200: #E2E8F0;
    out property <color> slate-300: #CBD5E1;
    out property <color> slate-400: #94A3B8;
    out property <color> slate-500: #64748B;
    out property <color> slate-600: #475569;
    out property <color> slate-700: #334155;
    out property <color> slate-800: #1E293B;

    // Night paper & ink (dark scheme).
    out property <color> night-shadow: #0B0812;
    out property <color> night-950: #17131F;
    out property <color> night-900: #221C2E;
    out property <color> night-850: #2C2540;
    out property <color> night-800: #3A3150;
    out property <color> night-700: #4A4063;
    out property <color> night-500: #6E6488;
    out property <color> night-450: #8479A0;
    out property <color> night-400: #A59DB8;
    out property <color> night-200: #DAD4E6;
    out property <color> cream: #F8F5EC;

    // Violet — brand / accent.
    out property <color> violet-50: #F3EEFF;
    out property <color> violet-100: #EDE9FE;
    out property <color> violet-300: #C4B5FD;
    out property <color> violet-400: #A78BFA;
    out property <color> violet-500: #8B5CF6;
    out property <color> violet-600: #7C3AED;
    out property <color> violet-700: #6D28D9;
    out property <color> violet-night: #2F2548;

    // Confetti hues.
    out property <color> pink-100: #FCE7F3;
    out property <color> pink-300: #F9A8D4;
    out property <color> pink-400: #F472B6;
    out property <color> pink-700: #BE185D;
    out property <color> pink-night: #43263A;

    out property <color> yellow-100: #FEF3C7;
    out property <color> yellow-300: #FCD34D;
    out property <color> yellow-400: #FBBF24;
    out property <color> yellow-500: #F59E0B;
    out property <color> yellow-700: #B45309;
    out property <color> yellow-night: #463A1E;

    out property <color> mint-100: #D1FAE5;
    out property <color> mint-300: #6EE7B7;
    out property <color> mint-400: #34D399;
    out property <color> mint-500: #10B981;
    out property <color> mint-700: #047857;
    out property <color> mint-night: #1D3B35;

    // Status & track-type hues.
    out property <color> blue-100: #DBEAFE;
    out property <color> blue-300: #93C5FD;
    out property <color> blue-500: #3B82F6;
    out property <color> blue-700: #1D4ED8;
    out property <color> blue-night: #243452;

    out property <color> red-100: #FEE2E2;
    out property <color> red-300: #FCA5A5;
    out property <color> red-500: #EF4444;
    out property <color> red-700: #B91C1C;
    out property <color> red-night: #47242B;
}
