import { Theme, Tone } from "../theme/theme.slint";
import { Icon } from "icon.slint";

// Compact, non-interactive label: media facts, track flags, counts. A
// pastel "leaf" (two rounded, two sharp corners) outlined in the tone's
// colour.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <image> icon;

    height: Theme.badge-height;
    border-top-left-radius: Theme.leaf-round;
    border-bottom-right-radius: Theme.leaf-round;
    border-top-right-radius: Theme.leaf-sharp;
    border-bottom-left-radius: Theme.leaf-sharp;
    border-width: Theme.border-width;
    border-color: tone == Tone.neutral ? Theme.border : Theme.tone-solid(tone);
    background: Theme.tone-background(tone);
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: text;

    HorizontalLayout {
        padding-left: Theme.space-2 + Theme.space-0-5;
        padding-right: Theme.space-2 + Theme.space-0-5;
        spacing: Theme.space-1;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: Theme.icon-xs; colorize: Theme.tone-foreground(root.tone); }
        }
        Text {
            text: root.text;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-bold;
            color: root.tone == Tone.neutral ? Theme.text-secondary : Theme.tone-foreground(root.tone);
            vertical-alignment: center;
        }
    }
}
