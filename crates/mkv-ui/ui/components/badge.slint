import { Theme, Tone } from "../theme/theme.slint";
import { Icon } from "icon.slint";

// Compact, non-interactive label: media facts, track flags, counts.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <image> icon;

    height: Theme.badge-height;
    border-radius: Theme.radius-full;
    background: Theme.tone-background(tone);
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: text;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-1;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: Theme.icon-xs; colorize: Theme.tone-foreground(root.tone); }
        }
        Text {
            text: root.text;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-medium;
            color: Theme.tone-foreground(root.tone);
            vertical-alignment: center;
        }
    }
}
