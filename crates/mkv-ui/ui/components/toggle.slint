import { Theme } from "../theme/theme.slint";
import { LabelText, CaptionText } from "typography.slint";

// Pill on/off switch that turns mint when on, with a bouncy knob.
// Controlled: it reports the requested state through `toggled` and only
// changes when the owner updates `checked`, so a binding like
// `checked: row.keep` never gets overwritten.
export component Toggle {
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    callback toggled(bool);

    // 44 × 24 switch centred in a full touch target.
    width: Theme.touch-target;
    height: Theme.touch-target;
    forward-focus: focus;

    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: accessible-name;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }

    // Dimmed here rather than on the root, where `opacity` would make Slint
    // copy the component into every place it is used.
    Rectangle {
        opacity: root.enabled ? 1 : 0.45;

        track := Rectangle {
            width: 44px;
            height: 24px;
            border-radius: self.height / 2;
            border-width: Theme.border-width;
            border-color: Theme.ink;
            background: root.checked ? Theme.toggle-on : Theme.toggle-off;
            animate background { duration: Theme.duration-fast; }

            knob := Rectangle {
                width: parent.height - 8px;
                height: self.width;
                y: 4px;
                x: root.checked ? parent.width - self.width - 4px : 4px;
                border-radius: self.width / 2;
                border-width: Theme.border-width;
                border-color: Theme.ink;
                background: Theme.toggle-knob;
                animate x { duration: Theme.duration-medium; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            }
        }

        Rectangle {
            x: track.x - 4px;
            y: track.y - 4px;
            width: track.width + 8px;
            height: track.height + 8px;
            border-radius: self.height / 2;
            border-width: focus.has-focus ? 2px : 0;
            border-color: Theme.focus-ring;
        }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// A labelled setting row: title and optional description on the left,
// switch on the right. The whole row is clickable.
export component ToggleRow {
    in property <string> label;
    in property <string> description;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    min-height: Theme.touch-target;

    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }

    HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            alignment: center;
            spacing: Theme.space-0-5;
            horizontal-stretch: 1;
            LabelText { text: root.label; wrap: word-wrap; }
            if root.description != "": CaptionText { text: root.description; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.checked;
                enabled: root.enabled;
                accessible-name: root.label;
                toggled(value) => { root.toggled(value); }
            }
        }
    }
}
