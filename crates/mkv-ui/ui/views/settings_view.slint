// Profiles and naming formats, with validation and a live preview against
// the open file. Stored in `config.toml`.

import { ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import {
    Theme, Tone, Icons, Badge, Button, ButtonVariant, ToggleRow, SectionCard, Banner, FormField,
    DisplayText, SecondaryText, CaptionText, BodyText,
} from "../components/index.slint";
import { Bridge } from "../bridge.slint";

export component SettingsView inherits VerticalLayout {
    padding: Theme.space-5;
    spacing: Theme.space-4;

    HorizontalLayout {
        spacing: Theme.space-3;
        VerticalLayout {
            spacing: Theme.space-1;
            horizontal-stretch: 1;
            DisplayText { text: "Settings"; }
            SecondaryText { text: "Profiles decide which tracks to keep, their order, names and flags."; }
        }
        if Bridge.s-dirty: VerticalLayout {
            alignment: center;
            Badge { text: "Unsaved changes"; tone: Tone.warning; }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-4;
        vertical-stretch: 1;

        form := ScrollView {
            horizontal-stretch: 3;
            VerticalLayout {
                // Without this the content takes its preferred width and
                // scrolls horizontally instead of wrapping.
                width: form.visible-width;
                padding-right: Theme.space-3;
                spacing: Theme.space-4;
                alignment: start;

                SectionCard {
                    title: "Profile";
                    HorizontalLayout {
                        spacing: Theme.space-2;
                        ComboBox {
                            horizontal-stretch: 1;
                            model: Bridge.s-profile-names;
                            current-index <=> Bridge.s-profile-index;
                            selected => { Bridge.s-profile-selected(self.current-index); }
                        }
                        Button { text: "Duplicate"; icon: Icons.copy-all; clicked => { Bridge.s-add-profile(); } }
                        Button {
                            text: "Delete";
                            variant: ButtonVariant.danger;
                            enabled: Bridge.s-profile-names.length > 1;
                            clicked => { Bridge.s-delete-profile(); }
                        }
                    }
                    FormField {
                        label: "Profile name";
                        LineEdit { text <=> Bridge.s-name; edited => { Bridge.s-edited(); } }
                    }
                }

                SectionCard {
                    title: "Video";
                    FormField {
                        label: "Track name";
                        hint: "Tokens: {Resolution} {DynamicRange} {Codec} {BitDepth} {3D} {Language}. Example: 2160p DV8 HDR10 HEVC";
                        LineEdit { text <=> Bridge.s-video-format; edited => { Bridge.s-edited(); } }
                    }
                }

                SectionCard {
                    title: "Audio";
                    FormField {
                        label: "Track name";
                        hint: "Tokens: {Language} {Format} {Channels} {Atmos} {Commentary} {Description}. Example: English DD+ 5.1 Atmos";
                        LineEdit { text <=> Bridge.s-audio-format; edited => { Bridge.s-edited(); } }
                    }
                    FormField {
                        label: "Language rules";
                        hint: "One rule per line, first match wins: <original languages> => <languages to keep, in order>. {original} is the language picked per file and * matches any. The first kept main track becomes default; tracks in the original language get the Original flag.";
                        TextEdit {
                            height: 96px;
                            text <=> Bridge.s-audio-rules;
                            edited => { Bridge.s-edited(); }
                        }
                    }
                    ToggleRow {
                        label: "Keep commentary tracks";
                        checked: Bridge.s-keep-commentary;
                        toggled(value) => { Bridge.s-keep-commentary = value; Bridge.s-edited(); }
                    }
                    ToggleRow {
                        label: "Keep audio description tracks";
                        checked: Bridge.s-keep-descriptions;
                        toggled(value) => { Bridge.s-keep-descriptions = value; Bridge.s-edited(); }
                    }
                }

                SectionCard {
                    title: "Subtitles";
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        FormField {
                            label: "Keep languages";
                            LineEdit { text <=> Bridge.s-sub-languages; edited => { Bridge.s-edited(); } }
                        }
                        FormField {
                            label: "Track name";
                            LineEdit { text <=> Bridge.s-sub-format; edited => { Bridge.s-edited(); } }
                        }
                    }
                    FormField {
                        label: "Order";
                        hint: "Tokens: {Language} {Kind} {Format}. Kinds: Forced, Full, SDH, CC, Signs & Songs, Commentary — detected from flags and track titles. SDH and CC set the hearing-impaired flag.";
                        LineEdit { text <=> Bridge.s-sub-order; edited => { Bridge.s-edited(); } }
                    }
                    ToggleRow {
                        label: "Default-flag forced subtitles for foreign-language films";
                        checked: Bridge.s-default-forced;
                        toggled(value) => { Bridge.s-default-forced = value; Bridge.s-edited(); }
                    }
                    ToggleRow {
                        label: "Detect forced subtitles by event count";
                        checked: Bridge.s-detect-forced;
                        toggled(value) => { Bridge.s-detect-forced = value; Bridge.s-edited(); }
                    }
                }

                SectionCard {
                    title: "File naming";
                    description: "Radarr and Sonarr compatible.";
                    FormField {
                        label: "Movie format";
                        TextEdit {
                            height: 64px;
                            wrap: word-wrap;
                            text <=> Bridge.s-movie-format;
                            edited => { Bridge.s-edited(); }
                        }
                    }
                    FormField {
                        label: "Episode format";
                        TextEdit {
                            height: 64px;
                            wrap: word-wrap;
                            text <=> Bridge.s-episode-format;
                            edited => { Bridge.s-edited(); }
                        }
                    }
                    FormField {
                        label: "Colon replacement";
                        ComboBox {
                            model: Bridge.s-colon-names;
                            current-index <=> Bridge.s-colon-index;
                            selected => { Bridge.s-edited(); }
                        }
                    }
                    FormField {
                        label: "Custom formats";
                        hint: "Matched against the source file name, one per line: Name = regex. Anything in [...] whose tokens are all empty is dropped, so [tmdbid-{TmdbId}] disappears without a TMDb ID. {prefix Token suffix}: the prefix and suffix only appear when the token has a value. Separators . _ - in token names replace spaces; ALL CAPS and lowercase token names change the value's case.";
                        TextEdit {
                            height: 64px;
                            text <=> Bridge.s-custom-formats;
                            edited => { Bridge.s-edited(); }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            width: 360px;
            spacing: Theme.space-4;

            SectionCard {
                title: "Preview";
                description: "What this profile does to the open file.";
                BodyText {
                    text: Bridge.s-preview == "" ? "Open a file to preview this profile." : Bridge.s-preview;
                    color: Bridge.s-preview == "" ? Theme.text-muted : Theme.text-primary;
                    wrap: word-wrap;
                    font-size: Theme.font-small;
                }
            }
            if Bridge.s-errors != "": Banner { text: Bridge.s-errors; tone: Tone.danger; }
            HorizontalLayout {
                spacing: Theme.space-2;
                Button {
                    text: "Save";
                    icon: Icons.save;
                    variant: ButtonVariant.primary;
                    enabled: Bridge.s-dirty && Bridge.s-errors == "";
                    clicked => { Bridge.s-save(); }
                }
                Button { text: "Revert"; enabled: Bridge.s-dirty; clicked => { Bridge.s-revert(); } }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Restore defaults";
                    icon: Icons.reset;
                    variant: ButtonVariant.ghost;
                    clicked => { Bridge.s-reset-defaults(); }
                }
            }
            CaptionText {
                text: "Saved settings apply to newly opened files. Use Apply profile or Apply to all to re-apply them to open files.";
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
