// Top bar: brand, one chip per open file (Slint's TabWidget only supports a
// static set of tabs, while files are opened and closed dynamically), and
// global actions. The tabs sit in a horizontally scrolling strip so any
// number of open files never widens the window.

import { Palette } from "std-widgets.slint";
import {
    Theme, Tone, Viewport, Icons, Icon, IconTile, StatusDot, Button, IconButton, ButtonVariant, ControlSize, CaptionText,
} from "../components/index.slint";
import { Bridge, DocTabData } from "../bridge.slint";

component FileTab inherits Rectangle {
    in property <DocTabData> data;
    in property <bool> active;
    callback clicked();
    callback close();

    property <Tone> status-tone: {
        if (data.failed) { return Tone.danger; }
        if (data.done) { return Tone.success; }
        return Tone.accent;
    }
    property <bool> show-status: data.failed || data.done || data.changed;

    height: Theme.touch-target;
    min-width: Viewport.md ? 120px : 96px;
    preferred-width: Viewport.md ? 220px : 160px;
    max-width: 260px;
    // The active file is a yellow sticker; others are quiet pills.
    border-radius: self.height / 2;
    border-width: Theme.border-width;
    border-color: active ? Theme.ink : (touch.has-hover ? Theme.border-strong : transparent);
    background: active ? Theme.yellow : transparent;
    drop-shadow-blur: 0;
    drop-shadow-offset-x: active ? 3px : 0;
    drop-shadow-offset-y: self.drop-shadow-offset-x;
    drop-shadow-color: Theme.shadow-pop;
    accessible-role: tab;
    accessible-label: data.title;
    accessible-item-selected: active;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    animate background, border-color { duration: Theme.duration-fast; }

    // Keyboard: Tab to reach, Enter / Space to switch to the file. Declared
    // before the touch area so clicks reach the touch area on top.
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.height / 2;
        border-width: focus.has-focus ? 2px : 0;
        border-color: Theme.focus-ring;
    }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: 0;
        spacing: Theme.space-2;

        if root.data.busy: Text {
            text: root.data.progress + "%";
            color: root.active ? Theme.on-confetti : Theme.accent-text;
            font-size: Theme.font-caption;
            font-weight: Theme.weight-extrabold;
            vertical-alignment: center;
        }
        if !root.data.busy && root.show-status: VerticalLayout {
            alignment: center;
            StatusDot { tone: root.status-tone; }
        }
        Text {
            text: root.data.title;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: Theme.font-body;
            font-weight: root.active ? Theme.weight-bold : Theme.weight-medium;
            color: root.active ? Theme.on-confetti : Theme.text-secondary;
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                size: ControlSize.small;
                enabled: !root.data.busy;
                on-confetti: root.active;
                accessible-name: "Close " + root.data.title;
                clicked => { root.close(); }
            }
        }
    }
}

export component AppBar inherits Rectangle {
    height: Theme.app-bar-height;
    background: Theme.surface;

    // Vertical centring of fixed-height controls in the bar.
    property <length> bar-inset: (Theme.app-bar-height - Theme.touch-target) / 2;

    HorizontalLayout {
        padding-left: Viewport.sm ? Theme.space-4 : Theme.space-2;
        padding-right: Viewport.sm ? Theme.space-3 : Theme.space-1;
        spacing: Theme.space-1;

        Rectangle {
            horizontal-stretch: 0;
            brand-hover := TouchArea { }
            HorizontalLayout {
                spacing: Theme.space-2 + Theme.space-0-5;
                padding-right: Viewport.sm ? Theme.space-4 : Theme.space-2;
                VerticalLayout {
                    alignment: center;
                    IconTile {
                        icon: Icons.movie;
                        tone: Tone.accent;
                        size: Theme.tile-sm;
                        lively: brand-hover.has-hover;
                        accessible-role: text;
                        accessible-label: "Track Editor";
                    }
                }
                // Wordmark from `sm` up; phones keep just the icon.
                if Viewport.sm: HorizontalLayout {
                    Text {
                        text: "Track";
                        font-family: Theme.family-heading;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-extrabold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Editor";
                        font-family: Theme.family-heading;
                        font-size: Theme.font-headline;
                        font-weight: Theme.weight-extrabold;
                        color: Theme.accent-text;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Scrolls sideways when the tabs don't fit; takes the free width.
        tab-strip := Flickable {
            horizontal-stretch: 1;
            min-width: 0;
            viewport-width: max(self.width, tab-row.preferred-width);
            viewport-height: self.height;

            tab-row := HorizontalLayout {
                width: tab-strip.viewport-width;
                height: tab-strip.height;
                alignment: start;
                spacing: Theme.space-1-5;
                // Room for the active tab's hard shadow.
                padding-top: root.bar-inset;
                padding-bottom: root.bar-inset;
                padding-right: Theme.space-1;

                for tab[i] in Bridge.tabs: FileTab {
                    data: tab;
                    active: i == Bridge.active-tab && !Bridge.show-settings && !Bridge.show-browser;
                    clicked => { Bridge.select-tab(i); }
                    close => { Bridge.close-tab(i); }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.plus;
                        enabled: !Bridge.loading;
                        accessible-name: "Open files";
                        clicked => { Bridge.open-requested(); }
                    }
                }
            }
        }

        if Bridge.loading: HorizontalLayout {
            spacing: Theme.space-1-5;
            padding-right: Theme.space-2;
            VerticalLayout {
                alignment: center;
                StatusDot { tone: Tone.accent; }
            }
            if Viewport.sm: CaptionText { text: "Analyzing…"; }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Theme.dark ? Icons.sun : Icons.moon;
                accessible-name: Theme.dark ? "Switch to light mode" : "Switch to dark mode";
                clicked => { Palette.color-scheme = Theme.dark ? ColorScheme.light : ColorScheme.dark; }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.settings;
                selected: Bridge.show-settings;
                accessible-name: "Settings";
                clicked => { Bridge.toggle-settings(); }
            }
        }
    }

    // Ink rule, like the outline of a sticker sheet.
    Rectangle {
        y: parent.height - self.height;
        height: Theme.border-width;
        background: Theme.ink;
    }
}
