// Server-side file browser (web build only): the browser can't touch the
// container's filesystem, so directories are listed through the API and
// every path is resolved/validated server-side.

import { ListView } from "std-widgets.slint";
import {
    Theme, Tone, Viewport, Icons, Icon, Button, ButtonVariant, Card, Divider, NavItem, DisplayText, AccentMark, SecondaryText, CaptionText,
} from "../components/index.slint";
import { Bridge } from "../bridge.slint";

export component VolumeBrowser inherits VerticalLayout {
    padding: Viewport.gutter;
    spacing: Theme.space-4;

    HorizontalLayout {
        spacing: Theme.space-2;
        VerticalLayout {
            spacing: Theme.space-1;
            horizontal-stretch: 1;
            DisplayText { text: "Library"; }
            HorizontalLayout {
                alignment: start;
                AccentMark { }
            }
            SecondaryText { text: "Choose a file to open it in a new tab. Only .mkv files are shown."; wrap: word-wrap; }
        }
        if Bridge.tabs.length > 0: VerticalLayout {
            alignment: center;
            Button {
                text: Viewport.sm ? "Close" : "";
                icon: Icons.close;
                variant: ButtonVariant.ghost;
                accessible-name: "Close library";
                clicked => { Bridge.browse-close(); }
            }
        }
    }

    // Never stretch: the list card below takes the free height, even while
    // the roots are still loading. Scrolls sideways when the roots don't fit.
    roots := Flickable {
        vertical-stretch: 0;
        min-width: 0;
        height: Theme.touch-target;
        viewport-width: max(self.width, roots-row.preferred-width);
        roots-row := HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            for root-id in Bridge.volume-roots: Button {
                text: root-id;
                icon: Icons.folder;
                selected: root-id == Bridge.browse-root;
                clicked => { Bridge.browse-root-selected(root-id); }
            }
        }
    }

    Card {
        vertical-stretch: 1;
        VerticalLayout {
            HorizontalLayout {
                padding-left: Theme.space-3;
                padding-right: Theme.space-3;
                padding-top: Theme.space-2;
                padding-bottom: Theme.space-2;
                spacing: Theme.space-2;
                Button {
                    icon: Icons.arrow-up;
                    variant: ButtonVariant.ghost;
                    width: self.height;
                    enabled: Bridge.browse-path != "";
                    accessible-name: "Parent folder";
                    clicked => { Bridge.browse-up(); }
                }
                SecondaryText {
                    text: Bridge.browse-root == "" ? "Pick a library to browse." : Bridge.browse-root + ":/" + Bridge.browse-path;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                CaptionText {
                    text: Bridge.browse-entries.length == 1 ? "1 item" : Bridge.browse-entries.length + " items";
                }
            }
            Divider { }
            ListView {
                vertical-stretch: 1;
                for entry in Bridge.browse-entries: HorizontalLayout {
                    padding-left: Theme.space-2;
                    padding-right: Theme.space-2;
                    padding-top: Theme.space-0-5;
                    padding-bottom: Theme.space-0-5;
                    NavItem {
                        text: entry.name;
                        icon: entry.is-dir ? Icons.folder : Icons.video;
                        icon-tone: entry.is-dir ? Tone.accent : Tone.video;
                        clicked => { Bridge.browse-entry-activated(entry.path, entry.is-dir); }
                    }
                }
            }
        }
    }
}
