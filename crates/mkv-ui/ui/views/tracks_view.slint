// Tracks page: profile toolbar, the track list (keep toggle, type, summary
// and active flags per row) and the inspector for the selected track.
//
// Responsive: from `lg` up the list and inspector sit side by side and
// fill the page; below it they stack at their natural heights (the page
// scrolls). The toolbar wraps onto two rows below `lg`, and rows drop the
// position chip and inline reorder buttons below `sm` (the inspector still
// has Move up / Move down).

import { ListView } from "std-widgets.slint";
import {
    Select, Theme, Tone, Viewport, Icons, IconTile, Badge, Toggle, Button, IconButton, ButtonVariant, ControlSize, Card,
    Divider, TitleText, LabelText, CaptionText, OverlineText,
} from "../components/index.slint";
import { Bridge, TrackRowData } from "../bridge.slint";
import { ViewState, TrackStyle } from "view_state.slint";
import { TrackInspector } from "track_inspector.slint";

component ProfileField inherits VerticalLayout {
    spacing: Theme.space-1-5;
    OverlineText { label: "Profile"; }
    Select {
        model: Bridge.profile-names;
        current-index <=> Bridge.profile-index;
        selected => { Bridge.profile-selected(self.current-index); }
    }
}

component LanguageField inherits VerticalLayout {
    spacing: Theme.space-1-5;
    OverlineText { label: "Original language"; }
    Select {
        model: Bridge.language-labels;
        current-index <=> Bridge.language-index;
        selected => { Bridge.language-selected(self.current-index); }
    }
}

component ProfileActions inherits HorizontalLayout {
    spacing: Theme.space-2;
    Button {
        text: "Apply profile";
        icon: Icons.wand;
        enabled: !Bridge.busy;
        clicked => { Bridge.apply-profile(); }
    }
    Button {
        text: Viewport.sm ? "Reset" : "";
        icon: Icons.reset;
        variant: ButtonVariant.ghost;
        enabled: !Bridge.busy;
        accessible-name: "Reset tracks";
        clicked => { Bridge.reset-tracks(); }
    }
    Rectangle { horizontal-stretch: 1; }
    if Bridge.doc-count > 1: Button {
        text: Viewport.sm ? "Apply to all" : "";
        icon: Icons.copy-all;
        variant: ButtonVariant.ghost;
        enabled: !Bridge.any-busy;
        accessible-name: "Apply to all files";
        clicked => { Bridge.apply-all(); }
    }
}

component ProfileToolbar inherits VerticalLayout {
    // One row from `lg` up.
    if Viewport.lg: HorizontalLayout {
        spacing: Theme.space-4;
        ProfileField { width: 200px; }
        LanguageField { width: 210px; }
        VerticalLayout {
            alignment: end;
            horizontal-stretch: 1;
            ProfileActions { }
        }
    }
    // Pickers on one row (stacked below `sm`), actions below.
    if !Viewport.lg: VerticalLayout {
        spacing: Theme.space-3;
        if Viewport.sm: HorizontalLayout {
            spacing: Theme.space-3;
            ProfileField { horizontal-stretch: 1; }
            LanguageField { horizontal-stretch: 1; }
        }
        if !Viewport.sm: ProfileField { }
        if !Viewport.sm: LanguageField { }
        ProfileActions { }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackRowData> track;
    in property <int> index;
    in property <bool> selected;
    // The list has keyboard focus: outline the selected row.
    in property <bool> list-focused;
    callback select();

    property <bool> show-actions: touch.has-hover || selected;
    property <string> summary: track.codec
        + (track.detail != "" ? "  ·  " + track.detail : "")
        + (track.language-name != "" ? "  ·  " + track.language-name : "");

    height: Theme.track-row-height;
    background: selected ? Theme.state-selected : (touch.has-hover ? Theme.state-hover : transparent);
    accessible-role: list-item;
    accessible-label: TrackStyle.label(track.kind) + " " + track.ordinal + ": " + track.name;
    accessible-item-selected: selected;
    accessible-action-default => { root.select(); }
    animate background { duration: Theme.duration-fast; }

    touch := TouchArea {
        clicked => { root.select(); }
    }

    // Keyboard focus indicator on the selected row.
    Rectangle {
        x: Theme.space-0-5;
        y: Theme.space-0-5;
        width: parent.width - 2 * Theme.space-0-5;
        height: parent.height - 2 * Theme.space-0-5;
        border-radius: Theme.radius-sm;
        border-width: root.selected && root.list-focused ? 2px : 0;
        border-color: Theme.focus-ring;
    }

    // Selection marker: a violet pill hugging the left edge.
    Rectangle {
        x: Theme.space-1-5;
        width: 6px;
        height: root.selected ? 28px : 0;
        border-radius: self.width / 2;
        background: Theme.accent;
        animate height { duration: Theme.duration-medium; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }

    HorizontalLayout {
        padding-left: Viewport.sm ? Theme.space-5 : Theme.space-4;
        padding-right: Theme.space-2;
        spacing: Viewport.sm ? Theme.space-3 : Theme.space-2;

        VerticalLayout {
            alignment: center;
            Toggle {
                checked: root.track.keep;
                accessible-name: "Keep track";
                toggled(value) => { Bridge.set-keep(root.index, value); }
            }
        }

        // Everything but the keep toggle recedes when a track is dropped.
        HorizontalLayout {
            spacing: Viewport.sm ? Theme.space-3 : Theme.space-2;
            horizontal-stretch: 1;
            min-width: 0;
            opacity: root.track.keep ? 1 : 0.45;

            // Position in the output file; tilts when selected.
            if Viewport.sm: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: Theme.radius-sm;
                    background: root.selected ? Theme.accent : Theme.surface-muted;
                    transform-rotation: root.selected ? -6deg : 0deg;
                    animate transform-rotation { duration: Theme.duration-medium; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    Text {
                        text: root.index + 1;
                        font-family: Theme.family-heading;
                        font-size: Theme.font-body;
                        font-weight: Theme.weight-extrabold;
                        color: root.selected ? Theme.on-accent : Theme.text-secondary;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconTile {
                    icon: TrackStyle.icon(root.track.kind);
                    tone: TrackStyle.tone(root.track.kind);
                    lively: touch.has-hover;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: Theme.space-0-5;
                horizontal-stretch: 1;
                min-width: 0;
                LabelText {
                    text: root.track.name != "" ? root.track.name : TrackStyle.label(root.track.kind) + " " + root.track.ordinal;
                    color: root.track.name != "" ? Theme.text-primary : Theme.text-secondary;
                    overflow: elide;
                }
                CaptionText { text: root.summary; overflow: elide; }
            }
            // Flags: clipped rather than widening the row when space runs
            // out; below `sm` they live in the inspector only.
            if Viewport.sm: Rectangle {
                min-width: 0;
                max-width: flags.preferred-width;
                horizontal-stretch: 1;
                clip: true;
                flags := HorizontalLayout {
                spacing: Theme.space-1;
                alignment: end;
                if !root.track.keep: VerticalLayout { alignment: center; Badge { text: "Dropped"; tone: Tone.danger; } }
                if root.track.is-default: VerticalLayout { alignment: center; Badge { text: "Default"; tone: Tone.accent; } }
                if root.track.is-forced: VerticalLayout { alignment: center; Badge { text: "Forced"; tone: Tone.warning; } }
                if root.track.is-original: VerticalLayout { alignment: center; Badge { text: "Original"; tone: Tone.success; } }
                if root.track.is-hi: VerticalLayout { alignment: center; Badge { text: "SDH"; } }
                if root.track.is-vi: VerticalLayout { alignment: center; Badge { text: "AD"; } }
                if root.track.is-commentary: VerticalLayout { alignment: center; Badge { text: "Commentary"; } }
                }
            }
        }

        // Reorder within the track's type; hidden (but space-holding) until
        // the row is hovered or selected to keep the list calm. Below `sm`
        // reordering is done from the inspector.
        if Viewport.sm: HorizontalLayout {
            visible: root.show-actions;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.chevron-up;
                    size: ControlSize.small;
                    enabled: root.track.can-up;
                    accessible-name: "Move up";
                    clicked => {
                        Bridge.move-track(root.index, root.index - 1);
                        ViewState.selected-track = root.index - 1;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.chevron-down;
                    size: ControlSize.small;
                    enabled: root.track.can-down;
                    accessible-name: "Move down";
                    clicked => {
                        Bridge.move-track(root.index, root.index + 1);
                        ViewState.selected-track = root.index + 1;
                    }
                }
            }
        }
    }

    Divider {
        y: parent.height - self.height;
    }
}

component TrackList inherits Card {
    // Scroll inside the card, or take the rows' natural height (stacked
    // layout, where the page scrolls instead).
    in property <bool> scrolls: true;

    VerticalLayout {
        HorizontalLayout {
            padding-left: Viewport.sm ? Theme.space-5 : Theme.space-4;
            padding-right: Theme.space-4;
            padding-top: Theme.space-4;
            padding-bottom: Theme.space-4;
            spacing: Theme.space-2 + Theme.space-0-5;
            TitleText { text: "Tracks"; font-size: Theme.font-headline; vertical-alignment: center; }
            // Count sticker.
            VerticalLayout {
                alignment: center;
                Rectangle {
                    min-width: 26px;
                    height: 26px;
                    border-radius: self.height / 2;
                    border-width: Theme.border-width;
                    border-color: Theme.ink;
                    background: Theme.pink;
                    accessible-role: text;
                    accessible-label: Bridge.tracks.length + " tracks";
                    HorizontalLayout {
                        padding-left: Theme.space-1-5;
                        padding-right: Theme.space-1-5;
                        Text {
                            text: Bridge.tracks.length;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-family: Theme.family-heading;
                            font-size: Theme.font-body;
                            font-weight: Theme.weight-extrabold;
                            color: Theme.on-confetti;
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if Bridge.change-count > 0: VerticalLayout {
                alignment: center;
                Badge {
                    text: Bridge.change-count == 1 ? "1 change" : Bridge.change-count + " changes";
                    tone: Tone.accent;
                }
            }
        }
        Divider { }

        // Keyboard: ↑/↓ move the selection, Space keeps or drops the
        // selected track.
        list-focus := FocusScope {
            vertical-stretch: 1;
            key-pressed(event) => {
                if (event.text == Key.UpArrow && ViewState.selected-track > 0) {
                    ViewState.selected-track -= 1;
                    return accept;
                }
                if (event.text == Key.DownArrow && ViewState.selected-track < Bridge.tracks.length - 1) {
                    ViewState.selected-track += 1;
                    return accept;
                }
                if (event.text == " " && ViewState.selected-track >= 0 && ViewState.selected-track < Bridge.tracks.length) {
                    Bridge.set-keep(ViewState.selected-track, !Bridge.tracks[ViewState.selected-track].keep);
                    return accept;
                }
                reject
            }

            // A layout so the conditional children count toward the
            // card's height.
            VerticalLayout {
                if root.scrolls: ListView {
                    for row[i] in Bridge.tracks: TrackRow {
                        track: row;
                        index: i;
                        selected: i == ViewState.selected-track;
                        list-focused: list-focus.has-focus;
                        select => {
                            ViewState.selected-track = i;
                            list-focus.focus();
                        }
                    }
                }
                if !root.scrolls: VerticalLayout {
                    for row[i] in Bridge.tracks: TrackRow {
                        track: row;
                        index: i;
                        selected: i == ViewState.selected-track;
                        list-focused: list-focus.has-focus;
                        select => {
                            ViewState.selected-track = i;
                            list-focus.focus();
                        }
                    }
                }
            }
        }
    }
}

export component TracksView inherits VerticalLayout {
    spacing: Theme.space-4;

    ProfileToolbar { }
    // One layout whose direction flips, rather than a copy of the list and
    // inspector for each arrangement: side by side (each scrolling inside
    // its card) from `lg` up, stacked at natural heights below it.
    FlexboxLayout {
        flex-direction: Viewport.lg ? FlexboxLayoutDirection.row : FlexboxLayoutDirection.column;
        flex-wrap: no-wrap;
        alignment: stretch;
        spacing: Theme.space-5;
        vertical-stretch: Viewport.lg ? 1 : 0;
        TrackList {
            horizontal-stretch: 1;
            scrolls: Viewport.lg;
        }
        TrackInspector {
            // A fixed-width side panel; full width when stacked.
            preferred-width: Theme.inspector-width;
            min-width: Viewport.lg ? Theme.inspector-width : 0px;
            horizontal-stretch: 0;
            scrolls: Viewport.lg;
            featured: true;
        }
    }
}
